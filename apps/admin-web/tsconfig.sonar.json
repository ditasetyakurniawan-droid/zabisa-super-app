{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "moduleResolution": "node"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "playwright-report",
    "test-results"
  ]
}
